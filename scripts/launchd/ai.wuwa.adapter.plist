<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.wuwa.adapter</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/ethanwu/wuwa-QQbot/scripts/run_adapter.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ethanwu/wuwa-QQbot</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- 官方 WS 会话超时重连频繁，别让 launchd 跟着抖 -->
  <key>ThrottleInterval</key>
  <integer>20</integer>

  <key>StandardOutPath</key>
  <string>/Users/ethanwu/wuwa-QQbot/logs/adapter.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ethanwu/wuwa-QQbot/logs/adapter.err.log</string>
</dict>
</plist>